#!/usr/bin/env python3
import json
import os
import re
import sys
import tomllib
from pathlib import Path


root = Path(os.environ.get("MISE_CONFIG_ROOT", Path.cwd())).resolve()
package = json.loads((root / "web/package.json").read_text())
workspace = (root / "web/pnpm-workspace.yaml").read_text()
lockfile = (root / "web/pnpm-lock.yaml").read_text()
mise = tomllib.loads((root / ".mise/config.toml").read_text()).get("tools", {})

failures = []
oxfmt_versions = re.findall(r"(?m)^  oxfmt@(\d+\.\d+\.\d+):$", lockfile)
if len(oxfmt_versions) != 1:
    failures.append("Expected exactly one bundled Oxfmt version in web/pnpm-lock.yaml.")
elif str(mise.get("oxfmt", "")) != oxfmt_versions[0]:
    failures.append(
        f"mise oxfmt pin {mise.get('oxfmt', '(missing)')} differs from "
        f"the bundled Oxfmt version {oxfmt_versions[0]}."
    )

for dependency in ("vite", "vite-plus"):
    value = package.get("dependencies", {}).get(dependency)
    if value is None:
        value = package.get("devDependencies", {}).get(dependency)
    if value != "catalog:":
        failures.append(f"web/package.json must use the pnpm catalog for {dependency}.")

for manifest, contents in (
    ("web/package.json", package),
    ("openapi/package.json", json.loads((root / "openapi/package.json").read_text())),
):
    package_manager = contents.get("packageManager", "")
    manager_match = re.fullmatch(r"pnpm@(.+)", package_manager)
    if manager_match is None:
        failures.append(f"{manifest} must pin pnpm in packageManager.")
    elif str(mise.get("pnpm", "")) != manager_match.group(1):
        failures.append(
            f"{manifest} packageManager {package_manager} differs from "
            f"mise pnpm pin {mise.get('pnpm', '(missing)')}."
        )

pins = {
    "Vite+": re.findall(r"(?m)^  vite-plus:\s*([0-9][^\s#]*)\s*$", workspace),
    "Vite core alias": re.findall(
        r"(?m)^  vite:\s*npm:@voidzero-dev/vite-plus-core@([0-9][^\s#]*)\s*$",
        workspace,
    ),
    "Vite core override": re.findall(
        r"(?m)^  vite@\*:\s*npm:@voidzero-dev/vite-plus-core@([0-9][^\s#]*)\s*$",
        workspace,
    ),
}
for source, matches in pins.items():
    if len(matches) != 1:
        failures.append(f"Expected exactly one {source} version in web/pnpm-workspace.yaml.")

all_versions = {version for matches in pins.values() for version in matches}
if len(all_versions) > 1:
    failures.append(f"Vite+ catalog and Vite core pins differ: {', '.join(sorted(all_versions))}.")
if "viteplus" not in mise:
    failures.append("mise must pin the Vite+ CLI as viteplus.")
elif all_versions and str(mise["viteplus"]) not in all_versions:
    failures.append(
        f"mise viteplus pin {mise['viteplus']} differs from web/pnpm-workspace.yaml "
        f"({', '.join(sorted(all_versions))})."
    )

if failures:
    print("\n".join(failures), file=sys.stderr)
    sys.exit(1)

print("Vite+, package manager, and mise pins are consistent.")
